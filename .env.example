# JobClass Environment Variables
# Copy this file to .env and adjust values as needed.

# Path to the DuckDB warehouse database file.
# Default: warehouse.duckdb (in working directory)
JOBCLASS_DB_PATH=warehouse.duckdb

# Root directory for raw downloaded artifacts.
# Default: raw/ (in project root)
# JOBCLASS_RAW_ROOT=raw

# Path to the source manifest YAML file.
# Default: config/source_manifest.yaml (in project root)
# JOBCLASS_MANIFEST_PATH=config/source_manifest.yaml

# Directory containing SQL migration files.
# Default: migrations/ (in project root)
# JOBCLASS_MIGRATIONS_DIR=migrations
